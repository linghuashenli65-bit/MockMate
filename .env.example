# MockMate 配置
# 复制此文件为 .env 并填入实际值

# AI 提供商 API Key（至少配置一个）
# MiMo API 端点: https://api.xiaomimimo.com/v1，可在 platform.xiaomimimo.com 获取 Key
MIMO_API_KEY=
DEEPSEEK_API_KEY=

# 默认 AI 提供商: mimo 或 deepseek
AI_PROVIDER=mimo

# MySQL 数据库（可选，不配置则使用 JSON 文件存储）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mockmate
